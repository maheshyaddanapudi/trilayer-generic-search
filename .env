# =============================================================================
# Trilayer Generic Search — example environment file
# Copy to ".env" and edit. Compose loads ".env" from the repo root.
# =============================================================================

# -----------------------------------------------------------------------------
# LLM provider selection: "anthropic" or "ollama"
# -----------------------------------------------------------------------------
LLM_PROVIDER=ollama

# -----------------------------------------------------------------------------
# Anthropic — only required when LLM_PROVIDER=anthropic
# -----------------------------------------------------------------------------
ANTHROPIC_API_KEY=sk-ant-placeholder
INTENT_MODEL=claude-haiku-4-5-20251001
SYNTHESIS_MODEL=claude-sonnet-4-6

# -----------------------------------------------------------------------------
# Ollama — only required when LLM_PROVIDER=ollama
# When TGS runs in Docker and Ollama runs on the Mac/Windows host, use
# host.docker.internal (already wired in docker-compose.yml via extra_hosts).
# When running TGS natively, use http://localhost:11434.
# -----------------------------------------------------------------------------
OLLAMA_BASE_URL=http://host.docker.internal:11434
OLLAMA_INTENT_MODEL=gemma4:31b
OLLAMA_SYNTHESIS_MODEL=gemma4:31b
OLLAMA_REQUEST_TIMEOUT_S=180

# -----------------------------------------------------------------------------
# Neo4j (overridden in docker-compose for the in-network hostname)
# -----------------------------------------------------------------------------
# NEO4J_URI=bolt://localhost:7687
# NEO4J_USER=neo4j
# NEO4J_PASSWORD=password

# -----------------------------------------------------------------------------
# PGVector (overridden in docker-compose for the in-network hostname)
# -----------------------------------------------------------------------------
# POSTGRES_URL=postgresql://tgs:tgs_password@localhost:5432/tgs_db
