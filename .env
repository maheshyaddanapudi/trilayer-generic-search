# PostgreSQL
POSTGRES_URL=postgresql://tgs:tgs@localhost:5432/tgs

# Neo4j
NEO4J_URI=bolt://localhost:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=tgs_pass1

# LLM - set provider to anthropic (key to be added later)
LLM_PROVIDER=anthropic
ANTHROPIC_API_KEY=your-anthropic-api-key-here
INTENT_MODEL=claude-opus-4-7
SYNTHESIS_MODEL=claude-opus-4-7

# Embedding
EMBEDDING_MODEL=all-MiniLM-L6-v2
EMBEDDING_DIMENSION=384

# Whoosh
WHOOSH_INDEX_DIR=./data/whoosh

# Ingestion
METADATA_FILE=./data/sample_metadata.xml
UPLOADS_DIR=./data/uploads
